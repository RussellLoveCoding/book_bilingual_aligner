# 复制为 .env 后填入自己的值（.env 已在 .gitignore 里）

# OpenAI 兼容接口（也可以用 DeepSeek / 通义 / Moonshot / 本地 vLLM / Ollama 等）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 请求结果缓存目录（重跑不花钱；置空关闭）
LLM_CACHE_DIR=.cache/llm

# 其他 OpenAI 兼容服务示例
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
# Moonshot:  LLM_BASE_URL=https://api.moonshot.cn/v1       LLM_MODEL=moonshot-v1-8k
# 本地 Ollama:LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen2.5:14b
